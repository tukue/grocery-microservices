<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.grocery.microservices</groupId>
    <artifactId>grocery-store</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>microservices/cart-service</module>
        <module>microservices/order-service</module>
        <module>microservices/product-service</module>
        <module>microservices/summary-service</module>
        <module>microservices/e2e-tests</module>
    </modules>
    <properties>
        <!-- Java 25 is the newest Long-Term Support release (GA 2025-09) and is fully
             supported by Spring Boot 4.1 (Java 17-26) across every module in this reactor.
             JDK 26 is non-LTS with permissive updates ending September 2026, so it is not
             selected for production stability. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc v3 is the only line compatible with Spring Boot 4.x. Boot does not
             manage springdoc, so its version is pinned here. -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- The postgresql and spring-retry versions are managed by the Spring Boot BOM
             (42.7.13 / 2.0.10+); no overrides are necessary. -->
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- The Spring Boot 4.1 BOM no longer manages spring-retry, so its
                 version is pinned here. -->
            <dependency>
                <groupId>org.springframework.retry</groupId>
                <artifactId>spring-retry</artifactId>
                <version>2.0.13</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project> 